# QRTR name service and pd-mapper 
service aera-qrtr-ns /vendor/bin/qrtr-ns -f 1
    class core
    disabled
    user root
    group root
    seclabel u:r:recovery:s0
    stdio_to_kmsg

service aera-pd-mapper /vendor/bin/pd-mapper
    class core
    disabled
    user system
    group system
    seclabel u:r:recovery:s0
    stdio_to_kmsg

on property:twrp.modules.loaded=true
    start aera-qrtr-ns
    start aera-pd-mapper

# Thermal guard: caps the CPU max frequency when the CPU gets hot.
service aera-thermal-guard /system/bin/aera_thermal_guard
    class core
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# Keep thermal monitoring outside the decryption critical path.
on property:twrp.decrypt.done=true
    start aera-thermal-guard

on property:ro.crypto.state=unencrypted
    start aera-thermal-guard

# Dynamic performance profile ("governer"): reads /virtual_sd/recovery/AERA/config.txt
# a few seconds after boot and applies performance / balanced / powersave / auto.
service aera-governer /system/bin/sh /system/bin/governer boot
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on boot
    start aera-governer
